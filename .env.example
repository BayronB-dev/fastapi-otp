# Copia este archivo como .env y completa los valores.

# --- Aplicación ---
APP_NAME="Auth OTP API"
ENVIRONMENT=development

# Clave para firmar los JWT. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Base de datos ---
DATABASE_URL=sqlite:///./app.db

# --- OTP ---
OTP_EXPIRE_MINUTES=15

# --- Correo ---
# "console" imprime el correo en el log (solo desarrollo).
# "smtp" lo envía de verdad usando los datos de abajo.
EMAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
# En Gmail usa una "contraseña de aplicación", no tu contraseña normal.
SMTP_PASSWORD=
SMTP_FROM=tu_correo@gmail.com
SMTP_USE_TLS=true

# --- Rate limiting (peticiones por ventana de tiempo por IP) ---
RATE_LIMIT_ENABLED=true
